# The npm tarball is driven primarily by package.json "files" (an allowlist of dist/ + native source
# + podspec + CHANGELOG). This .npmignore is a belt-and-suspenders guard so private/dev material can
# never leak into a published version even if "files" is widened later. Verify with `npm pack --dry-run`.

# Source & dev docs (the published package ships built dist/, not src/)
src/
docs/
examples/
example/
project-development-plan/

# AI / agent instruction files (private dev workflow — never publish)
**/CLAUDE.md
**/AGENTS.md
.claude/

# Tooling / config not needed by consumers
.github/
.vscode/
.idea/
tsconfig*.json
rollup.config.mjs
eslint.config.*
.eslintignore
.prettier*
.editorconfig
.nvmrc
.npmrc
*.tgz

# Tests & coverage
**/__tests__/
**/*.test.ts
**/*.spec.ts
coverage/

# Build caches / OS noise
.DS_Store
*.log
node_modules/
