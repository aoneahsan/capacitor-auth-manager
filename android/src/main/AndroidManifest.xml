<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Google sign-in (Credential Manager) only needs network access. No SMS / biometric permissions
         are declared: those providers are disabled in the Google-first build, and READ_SMS / RECEIVE_SMS
         are Play-restricted permissions that get consumer apps rejected. -->
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
