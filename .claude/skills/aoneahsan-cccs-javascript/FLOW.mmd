%% aoneahsan-cccs-javascript — full flow
flowchart TD
    trigger([Writing or reviewing JavaScript]) --> need{What is the task?}

    need -->|need a capability| platform{Does the platform<br/>already do this?}
    platform -->|yes| useplatform["Use it: fetch, URL/URLSearchParams,<br/>Intl, structuredClone, crypto.randomUUID,<br/>Object.groupBy, Resize/IntersectionObserver"]
    platform -->|no| vet[Vet the package —<br/>see packages-up-to-date]
    vet --> cdn{Loading it from a CDN?}
    cdn -->|yes| bundle[NEVER. Bundle it.<br/>CDN scripts are an extension-store rejection<br/>and a supply-chain risk]
    cdn -->|no| ok1[Add it]

    need -->|async work| independent{Are the awaits<br/>independent?}
    independent -->|yes| parallel["Promise.all / allSettled —<br/>sequential awaits over independent<br/>items is the usual avoidable slowdown"]
    independent -->|no| sequential[Sequential await is correct]
    parallel --> timeout
    sequential --> timeout
    timeout{Network call?}
    timeout -->|yes| abort[Add a timeout or AbortController.<br/>No ceiling = hung UI state]
    timeout -->|no| fireforget
    abort --> fireforget
    fireforget{Result ignored<br/>by the caller?}
    fireforget -->|yes| voidcatch["void send... with .catch inside —<br/>never an unhandled rejection,<br/>never breaks the user's flow"]
    fireforget -->|no| ok2[Await it]

    need -->|error handling| canact{Can THIS scope<br/>act on the error?}
    canact -->|no| propagate[Let it propagate.<br/>A catch that logs and rethrows is noise;<br/>one that swallows is a bug]
    canact -->|yes| narrow[Narrow the unknown binding first]
    narrow --> twomsgs[Two messages: actionable for the user,<br/>detailed for the logger]

    need -->|mutating data| shared{Does anyone else<br/>hold this value?}
    shared -->|yes| immutable["Use non-mutating ops:<br/>spread, map/filter, toSorted, with"]
    shared -->|no| localok[Local mutation is fine]

    useplatform --> zerocost
    ok1 --> zerocost
    bundle --> zerocost
    voidcatch --> zerocost
    ok2 --> zerocost
    propagate --> zerocost
    twomsgs --> zerocost
    immutable --> zerocost
    localok --> zerocost

    zerocost{Does this feature need<br/>a server or a paid tier?}
    zerocost -->|yes| rethink[Rethink: can it run client-side?<br/>Heavy work goes to a Web Worker.<br/>If truly not, see the nodejs skill —<br/>and never a paid service]
    zerocost -->|no| done([Client-side, zero-cost — done])
    rethink --> done

    classDef gateNode fill:#fff4e6,stroke:#d97706,color:#7c2d12
    classDef terminal fill:#ecfdf5,stroke:#059669,color:#064e3b
    classDef warn fill:#fef2f2,stroke:#dc2626,color:#7f1d1d
    class need,platform,cdn,independent,timeout,fireforget,canact,shared,zerocost gateNode
    class trigger,done terminal
    class bundle warn
