%% Project completion — full flow
%% Pure Mermaid.

flowchart TD
    start([Finalization session starts]) --> cat{Category confirmed<br/>in the scorecard?}
    cat -->|no| ask[Ask the owner: web app / extension /<br/>mobile app / package / other]
    ask --> record[Record category + date]
    cat -->|yes| audit
    record --> audit[Audit every criterion with live evidence]
    audit --> score[Score: full or 0 per row;<br/>held items reserved]
    score --> gates{Gates: live, Supabase,<br/>store confirmed}
    gates -->|firebase| migrate[Move to Supabase first]
    migrate --> audit
    gates -->|gaps| work[Close gaps in point order<br/>dummy first, tours, deploy]
    work --> audit
    gates -->|only owner chain left| chain[Hand the owner his store/console steps]
    chain --> confirm{Owner confirms live?}
    confirm -->|no| wait[Status: owner chain]
    confirm -->|yes| done([Mark complete with the date])
