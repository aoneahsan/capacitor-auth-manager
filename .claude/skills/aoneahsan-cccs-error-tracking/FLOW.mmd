%% Error tracking — full flow
%% Pure Mermaid. No Markdown fence.

flowchart TD
    trigger([Wiring error reporting]) --> dsn{Is the DSN configured?}

    dsn -->|"empty"| off[Tracking stays fully OFF.<br/>The project ships ready;<br/>the owner switches it on]
    dsn -->|set| maps{How are stacks symbolicated?}

    maps -->|"ship the .map files"| banned[🔴 Banned — that publishes the source]
    maps -->|"no maps at all"| useless[Stacks read a.b.c index-4f2a.js:1:88213<br/>— technically an alert, practically useless]
    maps -->|"generate → upload → DELETE"| good[sourcemap: true<br/>+ sentryVitePlugin<br/>+ filesToDeleteAfterUpload]

    banned --> good
    useless --> good

    good --> gate{Both greps clean?<br/>no .map in dist<br/>no sourceMappingURL in dist}
    gate -->|no| fixgate[Fix the build. Getting one half<br/>is easy; both is the point]
    fixgate --> gate

    gate -->|clean| rel{Release name MATCHES<br/>the uploaded map?}
    rel -->|no| mismatch[The map and the event never meet.<br/>One version constant drives both]
    mismatch --> rel

    rel -->|yes| pii{🔴 What is in the payload?}
    pii -->|"email, name, health values,<br/>note text, query strings"| scrub[beforeSend: strip them.<br/>user = id ONLY.<br/>An error report is a debugging aid,<br/>not a data export]
    scrub --> pii

    pii -->|"user id only"| bound{Boundaries scoped?}
    bound -->|"one at the app root"| blank[Any error blanks the whole app.<br/>One PER ROUTE SEGMENT, plus one around<br/>each independently-failing async region]
    blank --> bound

    bound -->|"per segment, branded fallback"| noise{Noise filtered + rate limited?}
    noise -->|no| quota[One error in a render loop burns<br/>the 5k monthly quota in an afternoon<br/>and blinds you for the rest of it]
    quota --> noise

    noise -->|yes| fan{🔴 Does the error also reach the<br/>ANALYTICS destinations?<br/>R-023 — four, not one}
    fan -->|"Sentry only"| blind[A spike is invisible beside the usage<br/>it broke. Fan out INSIDE the report<br/>function — at the call sites, the next<br/>caller forgets, and the failures that<br/>skip analytics are the unwatched ones]
    blind --> fan

    fan -->|"fanned out"| what{What crosses to analytics?}
    what -->|"the message or the stack"| content[🔴 Free text is unbounded. A database<br/>error can interpolate a READING into its<br/>own message. Send the error CLASS, where,<br/>handled, and the route PATTERN — never content]
    content --> what

    what -->|"bounded facts only"| verify{Deliberately throw one.<br/>Does it arrive in ALL FOUR — readable,<br/>tagged to the right release,<br/>carrying no personal data?}
    verify -->|no| diag[Diagnose: DSN · release mismatch<br/>· beforeSend returning null · CSP<br/>· a shared rate limiter suppressing one side]
    diag --> verify
    verify -->|yes| done([Done: readable stacks, no published<br/>source, no PII, one failure does not blank<br/>the app — and the spike is visible beside<br/>the usage it broke])

    maps -.the source-map ban.-> reg[(../rules/build-test-quality.md)]

    classDef gate fill:#fff4e6,stroke:#d97706,color:#7c2d12
    classDef terminal fill:#ecfdf5,stroke:#059669,color:#064e3b
    classDef stopnode fill:#fef2f2,stroke:#dc2626,color:#7f1d1d
    class dsn,maps,gate,rel,pii,bound,noise,fan,what,verify gate
    class trigger,done terminal
    class banned,scrub,blind,content stopnode
