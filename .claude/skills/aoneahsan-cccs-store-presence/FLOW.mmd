%% Store presence — full flow
%% Pure Mermaid. Renders as-is in any Mermaid viewer.

flowchart TD
    trigger([A record is about to say an app is or is not on a store]) --> registry[(policy/store-developer-accounts.json)]
    registry --> fetch[Fetch every registered developer page<br/>and collect the listed ids]
    fetch --> readok{Did each read return ids?}
    readok -->|no| retry[Retry, then use the browser fallback]
    retry --> readok2{Ids now?}
    readok2 -->|no| unknown([Unknown: change no record, report it])
    readok2 -->|yes| appid
    readok -->|yes| appid[Read the project's applicationId<br/>from its own build files]
    appid --> listed{Id on a registered page?}
    listed -->|yes| live[Live: build the link from listingUrlPattern]
    listed -->|no| client{Published under a client's account?}
    client -->|yes, listing answers 200| clientlive[Live under the client's account: link it and say whose]
    client -->|no| notlive[Not live: print no store link;<br/>say internal testing only if the project records it]
    live --> record[Update every surface in one change:<br/>CV fact file, Links block, project-live-urls.json, portfolio-info]
    clientlive --> record
    notlive --> record
    record --> verify{cvgen check or a re-read agrees?}
    verify -->|no| record
    verify -->|yes| done([Done: every record matches the developer pages])
    newacct([Owner shares a new account or store]) --> addentry[Add an accounts entry, bump version]
    addentry --> fetch
