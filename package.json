{
  "name": "capacitor-auth-manager",
  "version": "2.4.1",
  "description": "Capacitor + web authentication. Firebase-agnostic native & web Google sign-in (idToken/accessToken) for React, Vue, Angular and vanilla JS — a drop-in alternative to @codetrix-studio/capacitor-google-auth. More providers shipping one at a time.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/plugin.cjs.js"
    },
    "./react": {
      "types": "./dist/esm/react/index.d.ts",
      "import": "./dist/esm/react/index.js",
      "require": "./dist/react.cjs.js"
    },
    "./vue": {
      "types": "./dist/esm/vue/index.d.ts",
      "import": "./dist/esm/vue/index.js",
      "require": "./dist/vue.cjs.js"
    },
    "./angular": {
      "types": "./dist/esm/angular/index.d.ts",
      "import": "./dist/esm/angular/index.js",
      "require": "./dist/angular.cjs.js"
    },
    "./core": {
      "types": "./dist/esm/core/index.d.ts",
      "import": "./dist/esm/core/index.js",
      "require": "./dist/core.cjs.js"
    },
    "./providers/web": {
      "types": "./dist/esm/providers/web/index.d.ts",
      "import": "./dist/esm/providers/web/index.js",
      "require": "./dist/plugin.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "android/gradle.properties",
    "android/settings.gradle",
    "android/proguard-rules.pro",
    "dist/",
    "ios/Plugin/",
    "CapacitorAuthManager.podspec",
    "CHANGELOG.md",
    "!**/CLAUDE.md",
    "!**/AGENTS.md"
  ],
  "author": {
    "email": "aoneahsan@gmail.com",
    "name": "Ahsan Mahmood (Aoneahsan)",
    "url": "https://aoneahsan.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoneahsan/capacitor-auth-manager.git"
  },
  "bugs": {
    "url": "https://github.com/aoneahsan/capacitor-auth-manager/issues"
  },
  "homepage": "https://npmjs.com/package/capacitor-auth-manager",
  "keywords": [
    "auth",
    "authentication",
    "oauth",
    "google",
    "apple",
    "microsoft",
    "facebook",
    "github",
    "slack",
    "linkedin",
    "firebase",
    "email-magic-link",
    "sms",
    "email-code",
    "biometric",
    "react",
    "vue",
    "angular",
    "capacitor",
    "plugin",
    "native",
    "web",
    "pwa",
    "universal"
  ],
  "scripts": {
    "build": "npm run clean && npm run tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "tsc": "tsc -p tsconfig.build.json",
    "watch": "tsc --watch",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run lint",
    "swiftlint": "cd ios && swiftlint lint --fix --format --path Plugin --verbose",
    "configure": "node scripts/configure.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "capacitor-auth-configure": "./scripts/configure.js"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "rollup": "^4.61.1",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vue": "^3.5.35"
  },
  "peerDependencies": {
    "@angular/core": "^12.0.0 || ^13.0.0 || ^14.0.0 || ^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0",
    "@capacitor/core": "^7.4.2 || ^8.0.0",
    "@capacitor/preferences": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@capacitor/core": {
      "optional": true
    },
    "@capacitor/preferences": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "capacitor-biometric-authentication": "^2.3.1"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
