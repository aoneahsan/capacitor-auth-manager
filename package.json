{
  "name": "capacitor-auth-manager",
  "version": "3.0.0",
  "description": "Capacitor + web authentication. Firebase-agnostic native & web Google sign-in (idToken/accessToken) for React, Vue, Angular and vanilla JS \u2014 a drop-in alternative to @codetrix-studio/capacitor-google-auth. More providers shipping one at a time.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/plugin.cjs.js"
    },
    "./react": {
      "types": "./dist/esm/react/index.d.ts",
      "import": "./dist/esm/react/index.js",
      "require": "./dist/react.cjs.js"
    },
    "./vue": {
      "types": "./dist/esm/vue/index.d.ts",
      "import": "./dist/esm/vue/index.js",
      "require": "./dist/vue.cjs.js"
    },
    "./angular": {
      "types": "./dist/esm/angular/index.d.ts",
      "import": "./dist/esm/angular/index.js",
      "require": "./dist/angular.cjs.js"
    },
    "./core": {
      "types": "./dist/esm/core/index.d.ts",
      "import": "./dist/esm/core/index.js",
      "require": "./dist/core.cjs.js"
    },
    "./providers/web": {
      "types": "./dist/esm/providers/web/index.d.ts",
      "import": "./dist/esm/providers/web/index.js",
      "require": "./dist/providers-web.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "android/src/main/**",
    "android/build.gradle",
    "android/gradle.properties",
    "android/settings.gradle",
    "android/proguard-rules.pro",
    "dist/**",
    "ios/Plugin/**",
    "scripts/configure.js",
    "CapacitorAuthManager.podspec",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "AI-INTEGRATION-GUIDE.md",
    "android/consumer-rules.pro"
  ],
  "author": {
    "email": "aoneahsan@gmail.com",
    "name": "Ahsan Mahmood (Aoneahsan)",
    "url": "https://aoneahsan.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoneahsan/capacitor-auth-manager.git"
  },
  "bugs": {
    "url": "https://github.com/aoneahsan/capacitor-auth-manager/issues"
  },
  "homepage": "https://capacitor-auth-manager-docs.aoneahsan.com",
  "funding": "https://aoneahsan.com/payment?project-id=capacitor-auth-manager&project-identifier=capacitor-auth-manager",
  "keywords": [
    "capacitor",
    "authentication",
    "google-sign-in",
    "oauth",
    "id-token",
    "capacitor-plugin",
    "react",
    "vue",
    "angular"
  ],
  "scripts": {
    "build": "yarn clean && yarn tsc && node scripts/mark-esm.js && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "tsc": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "watch": "tsc --watch",
    "lint": "eslint . --max-warnings 0",
    "prettier": "prettier --write .",
    "prepack": "yarn build",
    "prepublishOnly": "yarn typecheck && yarn lint && yarn build && yarn test && yarn smoke:tarball",
    "swiftlint": "cd ios && swiftlint lint --fix --format --path Plugin --verbose",
    "configure": "node scripts/configure.js",
    "smoke:tarball": "node --test test/tarball-smoke.test.js",
    "test": "node --test test/google.test.js test/manager.test.js",
    "sync:apps-config": "trapeze run apps-config.yaml",
    "typecheck:clean": "tsc -b tsconfig.build.json --force",
    "smoke:native": "node scripts/native-smoke.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "capacitor-auth-configure": "./scripts/configure.js"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/common": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@trapezedev/configure": "^7.1.10",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.3",
    "rxjs": "^7.8.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@capacitor/core": "^7.4.2 || ^8.0.0",
    "@capacitor/preferences": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "rxjs": "^7.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/router": {
      "optional": true
    },
    "@capacitor/preferences": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "packageManager": "yarn@4.17.1",
  "resolutions": {
    "plist/@xmldom/xmldom": "^0.9.12",
    "xcode/uuid": "^11.1.1"
  }
}
