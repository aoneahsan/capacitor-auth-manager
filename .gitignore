# Node modules
node_modules/

# Build output
dist/
build/
www/
.output/
.vite/
.next/
.docusaurus/
.wxt/
*.iml

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files — PRIVATE repo: .env / secrets ARE tracked in git (do NOT ignore them).
# Templates like .env.example stay tracked as well.

# Example app specific
example/node_modules/
example/dist/
example/build/
example/android/
example/ios/

# Native projects (for plugin development, these are generated)
android/.gradle/
android/build/
android/local.properties
ios/Pods/
ios/build/
ios/DerivedData/

# Temporary files
*.tmp
*.temp
.cache/

# Coverage
coverage/
.nyc_output/

# Package lock files (using yarn)
package-lock.json

*.ignore.*
project-record-ignore/
# Firebase hosting cache (per 2026-04-22: untracked across all projects)
.firebase/hosting.*

# Yarn 4 (Berry) — ignore cache/state, allow patches/plugins/releases/sdks/versions
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
# Nested sub-project Yarn artifacts (examples/*) — never commit install state/cache
**/.yarn/install-state.gz
**/.yarn/cache
